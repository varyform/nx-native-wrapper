<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- the checkout a developer build uses (its .venv and nxnative, as bin/setup made them);
    bin/release builds
	     with NX_SOURCE_ROOT empty, so a released app keeps everything in its own folder (AppHome) -->
    <key>NXSourceRoot</key>
    <string>$(NX_SOURCE_ROOT)</string>
    <!-- Sources: a repository's catalog and files over plain http on the local network (a .local or single-label name);
         anywhere else takes https (RepositoryAddress) -->
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsLocalNetworking</key>
      <true/>
    </dict>
    <!-- Settings › Devices › iPhone & iPad App: the server the iOS app finds over Bonjour (RemoteServer) -->
    <key>NSBonjourServices</key>
    <array>
      <string>_nxplay._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>NX Play on your iPhone or iPad finds this Mac on the local network to list your games and install them there.</string>
  </dict>
</plist>
