#!/usr/bin/env bash
# Code statistics, as `rails stats` gives them: lines, lines of code, types and functions for each part of the repo,
# and how much test code there is for the code the tests cover. Only the files git would track count (new ones
# included), so build output and downloads never do.
set -euo pipefail
cd "$(dirname "$0")/.."

kit=Packages/NXPlayKit/Sources/NXPlayKit

# name|kind|git pathspecs (space-separated); kind picks the comment and function syntax
groups=(
  "Mac app|swift|App/*.swift"
  "Library|swift|:(glob)$kit/*.swift"
  "Models|swift|$kit/Model"
  "Views|swift|$kit/Views"
  "iOS app|swift|iOS/Sources"
  "nxplay|bash|nxplay"
  "Scripts|bash|bin"
  "Tests|swift|Packages/NXPlayKit/Tests"
)

# files lines loc types funcs, for the files on stdin
count() {
  local kind=$1
  local files=() file
  while IFS= read -r file; do files+=("$file"); done  # no mapfile: macOS's bash is 3.2
  if ((${#files[@]} == 0)); then
    echo "0 0 0 0 0"
    return
  fi
  awk -v kind="$kind" -v files="${#files[@]}" '
    { lines++ }
    {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line == "") next
      if (kind == "swift" && line ~ /^\/\//) next
      if (kind == "bash" && line ~ /^#/) next
      loc++
      if (kind == "swift") {
        if (line ~ /^(@[A-Za-z]+ )*((public|private|fileprivate|internal|open|final|nonisolated|indirect) )*(struct|class|enum|actor|protocol) [A-Za-z_]/) types++
        if (line ~ /(^|[ \t])func [A-Za-z_]/) funcs++
      } else if (line ~ /^(function )?[A-Za-z_][A-Za-z0-9_]*\(\) *\{/) {
        funcs++
      }
    }
    END { printf "%d %d %d %d %d\n", files, lines, loc, types, funcs }
  ' "${files[@]}"
}

# rounded box-drawing lines; the padding stays in plain ASCII, as printf pads by bytes
cell="│ %-10s │ %6s │ %7s │ %6s │ %6s │ %6s │ %5s │\n"
widths=(12 8 9 8 8 8 7)

row() {
  local per="-"
  (($6 > 0)) && per=$(($4 / $6))
  # shellcheck disable=SC2059 # the format is ours
  printf "$cell" "$1" "$2" "$3" "$4" "$5" "$6" "$per"
}

# rule <left> <joint> <right>
rule() {
  local line=$1 width i
  for width in "${widths[@]}"; do
    for ((i = 0; i < width; i++)); do line+="─"; done
    line+=$2
  done
  printf "%s\n" "${line%"$2"}$3"
}

rule ╭ ┬ ╮
# shellcheck disable=SC2059
printf "$cell" Name Files Lines LOC Types Funcs "LOC/F"
rule ├ ┼ ┤
total=(0 0 0 0 0)
code_loc=0
test_loc=0
for group in "${groups[@]}"; do
  IFS='|' read -r name kind specs <<< "$group"
  # shellcheck disable=SC2086 # the pathspecs split on purpose
  read -r files lines loc types funcs < <(git ls-files --cached --others --exclude-standard -- $specs | count "$kind")
  row "$name" "$files" "$lines" "$loc" "$types" "$funcs"
  total=($((total[0] + files)) $((total[1] + lines)) $((total[2] + loc)) $((total[3] + types)) $((total[4] + funcs)))
  if [[ $name == Tests ]]; then
    test_loc=$loc
  elif [[ $kind == swift ]]; then
    code_loc=$((code_loc + loc))  # what the tests are for: the Swift code; nxplay and bin are checked by shellcheck
  fi
done
rule ├ ┼ ┤
row Total "${total[@]}"
rule ╰ ┴ ╯

tests=$(git ls-files --cached --others --exclude-standard -- Packages/NXPlayKit/Tests | xargs grep -ho '@Test' | wc -l | tr -d ' ')
ratio=$(awk -v c="$code_loc" -v t="$test_loc" 'BEGIN { printf "%.1f", c ? t / c : 0 }')
echo "  Swift code LOC: $code_loc    Test LOC: $test_loc    Code to Test Ratio: 1:$ratio    Tests: $tests"
