#!/usr/bin/env bash
# Start a Switch game on the Mac through nxnative: build it once with
# scripts/build_ipa_from_nsp.py --platform mac, then reuse the run command the build printed.
#
# usage: nxplay [--rebuild] [--build-only] [--ipa | --mac-app] [--fps] [--fullscreen] [--lang <code>] <game folder> [extra build_ipa_from_nsp.py options...]
#   --build-only   build (when needed) and save the launcher, without starting the game
#   (a <title ID>_build/keep file stops nxnative updates from rebuilding that build; --rebuild still does)
#   --ipa          build the iOS IPA instead, into the game folder (needs the NSPs)
#   --mac-app      pack a standalone Mac app of the game instead, <game name>.app in the game folder (needs the NSPs);
#                  it keeps its own save in ~/Library/Application Support/nxnative/<title ID>
#   --device <udid>  install on a device through Xcode instead: prepare the game's Xcode project, build it signed
#                  with your team (Xcode > Settings > Apple Accounts), install and start it; pass --team-id <id>
#                  (and --bundle-id) after the game folder
#   --fps          Apple's Metal performance HUD over the game (DM_METAL_HUD=1): frame rate, frame and GPU time, memory
#   --fullscreen   start the game's window in full screen (DM_FULLSCREEN=1); ⌃⌘F or the green button leave it
#   --allow-other-metal  build shaders with this Mac's Metal compiler even when nxnative tested another one
#                  (nxnative's own --allow-other-metal, passed to every build; issue #242)
#   --lang <code>  game language for this run (DM_LANG: en-US, ja, fr, de, zh-Hans, ...); it must be one the game has
#   --settings     write the game's settings list (<title ID>_build/nxplay-settings.json, nxnative's dm/games/settings.py)
#                  for a game already built, without updating nxnative, and exit; a build and a play write it too.
#                  Each setting is an environment variable (DM_FPS_TARGET=30, ...) the game reads when it starts
# env:   NXNATIVE (repository; default ./nxnative in this checkout, as bin/setup clones it, else ../nxnative beside it),
#        NXPLAY_VENV (Python environment; default .venv in this checkout, made by bin/setup), NX_KEYS (default ~/.switch/prod.keys),
#        DM_SAVE_SYNC (nxnative's cloud saves: a folder, icloud, or 0; passed on to the game as it is),
#        NXPLAY_SETTINGS (names of DM_ variables in the environment the game is given, said in the output when it starts)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${NXNATIVE:-}" ]]; then repo="$NXNATIVE"
elif [[ -d "$here/nxnative" ]]; then repo="$here/nxnative"
else repo="$here/../nxnative"; fi
keys="${NX_KEYS:-$HOME/.switch/prod.keys}"

# nxnative's Python packages live in this checkout's .venv: first on PATH, since its shell tools call a bare python3 too
venv="${NXPLAY_VENV:-$here/.venv}"
if [[ -x "$venv/bin/python3" ]]; then
  export VIRTUAL_ENV="$venv" PATH="$venv/bin:$PATH"
else
  echo "nxplay: no Python environment at $venv (run bin/setup); using $(command -v python3 || echo 'no python3')" >&2
fi
launcher_name=start_mac.sh

rebuild=0 explicit_rebuild=0 fps=0 fullscreen=0 other_metal=() build_only=0 ipa=0 mac_app=0 lang="" device="" settings_only=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) rebuild=1 explicit_rebuild=1; shift ;;
    --build-only) build_only=1; shift ;;
    --settings) settings_only=1; shift ;;
    --ipa) ipa=1; shift ;;
    --mac-app) mac_app=1; shift ;;
    --device) device="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    --fps) fps=1; shift ;;
    --fullscreen) fullscreen=1; shift ;;
    --allow-other-metal) other_metal=(--allow-other-metal); shift ;;
    --lang) lang="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    *) break ;;
  esac
done
if [[ -n "$lang" && ! "$lang" =~ ^[A-Za-z]{2}(-[A-Za-z0-9]+)?$ ]]; then
  echo "nxplay: --lang wants a language code such as en-US, ja or zh-Hans, not '$lang'" >&2
  exit 2
fi
if [[ -n "$device" && ! "$device" =~ ^[0-9A-Fa-f-]+$ ]]; then
  echo "nxplay: --device wants a device UDID (xcrun devicectl list devices), not '$device'" >&2
  exit 2
fi
if [[ $# -lt 1 ]]; then
  echo "usage: $(basename "$0") [--rebuild] [--build-only] [--settings] [--ipa | --mac-app | --device <udid>] [--fps] [--fullscreen] [--allow-other-metal] [--lang <code>] <game folder> [build_ipa_from_nsp.py options...]" >&2
  exit 2
fi
game="$(cd "$1" && pwd)"; shift

# The newest <title ID>_build/start_mac.sh whose Mac host is still there
find_launcher() {
  local best="" f
  for f in "$game"/*_build/"$launcher_name"; do
    [[ -f "$f" && -x "$(dirname "$f")/tools/dmhost" ]] || continue
    [[ -z "$best" || "$f" -nt "$best" ]] && best="$f"
  done
  echo "$best"
}

# The game's Mac app (Make Mac App): <game name>.app in the game folder with the Mac host inside, not any app that
# happens to be there. The newest one.
find_app() {
  local best="" a
  for a in "$game"/*.app; do
    [[ -x "$a/Contents/MacOS/dmhost" && -x "$a/Contents/MacOS/nxnative" ]] || continue
    [[ -z "$best" || "$a" -nt "$best" ]] && best="$a"
  done
  echo "$best"
}

plist() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2> /dev/null; }

# Whether Play may start the app instead of the launcher: the app runs the same nxnative code as the build or newer.
# --mac-app records the code it packed with in <title ID>_build/app.tree; an app packed before that is current when
# it is newer than the launcher. After an nxnative update the build is rebuilt and the app, still on the old code,
# is not current until Make Mac App packs it again.
app_is_current() {
  local app="$1" launcher="$2" tree built
  tree="$(cat "$(dirname "$launcher")/app.tree" 2> /dev/null || true)"
  built="$(sed -n 's/^# nxnative tree //p' "$launcher")"
  if [[ -n "$tree" ]]; then
    [[ "$tree" == "$built" || "$tree" == "$(git -C "$repo" rev-parse 'HEAD^{tree}' 2> /dev/null)" ]]
  else
    [[ "$app/Contents/Info.plist" -nt "$launcher" ]]
  fi
}

# The app opened from Finder or the Dock keeps its save in ~/Library/Application Support/nxnative/<title ID>/save,
# until nxnative's dataFolder (seedds/nxnative#460). Its launcher reads that folder's env.txt, and a variable there
# that the launch environment leaves unset wins over its own folder: pointed at the game's save and cheats, a start
# from Finder plays on from the same save as NX Play. Not when the app already has a save of its own (two saves with
# their own progress: cloud saves keep them in step) or the player set DM_SAVE there; the player's other lines stay.
# Written again at each play, so a moved library is followed at its next play.
share_save() {
  local app="$1" build="$2" id sup env mark="# nxplay: the save NX Play plays this game with"
  id="$(plist "$app" DMTitleID)"
  [[ -n "$id" ]] || return 0
  sup="$HOME/Library/Application Support/nxnative/$id"
  env="$sup/env.txt"
  if ! grep -qF "$mark" "$env" 2> /dev/null; then
    if grep -q '^DM_SAVE=' "$env" 2> /dev/null; then return 0; fi
    if [[ -n "$(find "$sup/save" "$sup/save_device" -type f 2> /dev/null | head -1)" ]]; then
      echo "nxplay: $(basename "$app") opened from Finder keeps its own save ($sup/save); turn on cloud saves in NX Play and in the app's settings window to keep the two in step"
      return 0
    fi
  fi
  mkdir -p "$sup"
  { grep -vF "$mark" "$env" 2> /dev/null | grep -v -e '^DM_SAVE=' -e '^DM_CHEATS=' || true
    printf '%s\nDM_SAVE=%s\nDM_CHEATS=%s\n' "$mark" "$build/run/save" "$build/cheats"; } > "$env.tmp"
  mv -f "$env.tmp" "$env"
}

# The game's settings as nxnative lists them for its Mac app (dm/games/settings.py, a Mac app's launcher.json), beside
# the launcher, for NX Play's Game Settings: written again whenever the launcher is newer. The inputs are the build's
# own: its rewritten modules (the launcher's last word), the control data of that version, the graphics API its
# shaders were made for, a provisional profile in it. A list that can't be made only says so: the game plays as before.
settings_name=nxplay-settings.json
write_settings() {
  local build out patched nacp gfx games f
  build="$(dirname "$1")"; out="$build/$settings_name"
  [[ -f "$out" && "$out" -nt "$1" ]] && return 0
  [[ -f "$repo/dm/games/settings.py" ]] || return 0   # an nxnative from before per-game settings
  patched="$build/$(basename "$(python3 -c 'import shlex, sys; print(next(shlex.split(l) for l in open(sys.argv[1]) if l.startswith("cd "))[-1])' "$1")")"
  nacp="$build/extract/${patched##*/patched_}/control.nacp"
  if [[ ! -f "$nacp" ]]; then
    for f in "$build"/extract/*/control.nacp; do [[ -f "$f" && ( ! -f "$nacp" || "$f" -nt "$nacp" ) ]] && nacp="$f"; done
  fi
  if [[ -d "$build/shader/vk" ]]; then gfx=vulkan; elif [[ -d "$build/shader/gl" ]]; then gfx=gl; else gfx=nvn; fi
  games="${DM_GAMES_DIR:-}"
  [[ -d "$build/profile" ]] && games="$build/profile${games:+:$games}"
  if (cd "$repo" && GFXAPI="$gfx" SETTINGS_PLATFORM=mac DM_LANG=en-US DM_GAMES_DIR="$games" \
      python3 dm/games/settings.py "$(basename "$build" _build)" "$patched" "$nacp" "$out.tmp") > /dev/null; then
    mv -f "$out.tmp" "$out"
  else
    rm -f "$out.tmp"
    echo "nxplay: no settings list for this game (dm/games/settings.py failed); it plays with its tested settings" >&2
  fi
}

if [[ $settings_only -eq 1 ]]; then
  launcher="$(find_launcher)"
  if [[ -z "$launcher" ]]; then echo "nxplay: $game has no Mac build yet" >&2; exit 1; fi
  write_settings "$launcher"
  [[ -f "$(dirname "$launcher")/$settings_name" ]] || exit 1
  echo "settings: $(dirname "$launcher")/$settings_name"
  exit 0
fi

# Latest nxnative first; new commits make the saved launcher stale, so they force a rebuild.
# A checkout used through nxplay has no commits of its own, so a rewritten upstream (a force push) is followed too,
# once it is certain that moving to the new tip loses nothing.

# HEAD holds nothing local: it is behind a former upstream tip (the upstream's reflog; a fresh clone's starts only at
# the force push), or the branch only ever moved by clone, fast-forward and reset (its own reflog)
no_local_commits() {
  local tip branch moves
  for tip in $(git -C "$repo" rev-list --walk-reflogs -n 50 '@{u}'); do
    git -C "$repo" merge-base --is-ancestor HEAD "$tip" && return 0
  done
  branch="$(git -C "$repo" symbolic-ref --quiet --short HEAD)" || return 1
  moves="$(git -C "$repo" reflog show --format=%gs "$branch")"
  [[ -n "$moves" ]] && ! grep -qvE '^(clone|reset|branch): |: [Ff]ast-forward$' <<<"$moves"
}

update_nxnative() {
  git -C "$repo" fetch --quiet || return 1
  local upstream tip
  upstream="$(git -C "$repo" rev-parse '@{u}')" || return 1
  if [[ "$upstream" == "$before" ]]; then echo "nxnative: up to date"; return 0; fi
  if git -C "$repo" merge-base --is-ancestor HEAD '@{u}'; then
    git -C "$repo" merge --ff-only --quiet '@{u}'
    return
  fi
  if no_local_commits; then
    echo "nxnative: upstream rewrote its history (force push); following it, no local commits to keep"
    git -C "$repo" reset --keep '@{u}'   # keeps uncommitted edits, refuses when the new history touches them
    return
  fi
  echo "nxplay: $repo has commits upstream does not; merge or rebase them by hand" >&2
  return 1
}

before="$(git -C "$repo" rev-parse HEAD)"
if update_nxnative; then
  if [[ "$(git -C "$repo" rev-parse HEAD)" != "$before" ]]; then
    count="$(git -C "$repo" rev-list --count "$before..HEAD")"
    # a rewrite can re-create the same code under new commit ids: nothing to rebuild then
    if [[ "$(git -C "$repo" rev-parse "$before^{tree}")" == "$(git -C "$repo" rev-parse 'HEAD^{tree}')" ]]; then
      echo "nxnative updated: $count new commit$([[ $count == 1 ]] || echo s), same files as before, no rebuild"
    else
      echo "nxnative updated: $count new commit$([[ $count == 1 ]] || echo s), rebuilding"
      rebuild=1
    fi
    git -C "$repo" --no-pager log --no-decorate --format='  %C(yellow)%h%C(reset) %s %C(dim)(%an, %ar)%C(reset)' -n 30 "$before..HEAD"
    if (( count > 30 )); then echo "  … and $(( count - 30 )) older"; fi
    # the ones for this game's profile, which a long list can bury
    for b in "$game"/*_build; do
      [[ -d "$b" ]] || continue
      ours="$(git -C "$repo" --no-pager log --no-decorate --no-merges --format='  %C(yellow)%h%C(reset) %s' "$before..HEAD" -- "dm/games/$(basename "$b" _build)")"
      if [[ -n "$ours" ]]; then echo "for this game:"; echo "$ours"; fi
      break
    done
  fi
else
  echo "nxplay: could not update $repo, going on with the current code" >&2
fi

# nxnative's README names the Python packages its scripts import (step 1's pip install line). One added there that this
# environment lacks fails only mid-build, on its import (zbic: system 22.0.0 code): name it now. A line that changed
# shape, or a marker this can't read, checks nothing rather than warn wrongly.
missing_packages() {
  python3 - "$repo/README.md" <<'PY'
import re, shlex, sys
from importlib.metadata import PackageNotFoundError, distribution
try:
    line = re.search(r'^python3 -m pip install (.+)$', open(sys.argv[1], encoding='utf-8').read(), re.M)
    words = shlex.split(line.group(1)) if line else []
except (OSError, ValueError):
    words = []
for word in words:
    if word.startswith('-'): continue
    req, _, marker = word.partition(';')
    if marker.strip():
        m = re.fullmatch(r"\s*python_version\s*(<|<=|>|>=|==|!=)\s*['\"](\d+(?:\.\d+)*)['\"]\s*", marker)
        if not m: continue
        have, want = sys.version_info[:2], tuple(int(x) for x in m[2].split('.'))
        if not {'<': have < want, '<=': have <= want, '>': have > want, '>=': have >= want, '==': have == want, '!=': have != want}[m[1]]: continue
    name = re.split(r'[\s<>=!~\[]', req.strip(), maxsplit=1)[0]
    if not name: continue
    try: distribution(name)
    except PackageNotFoundError: print(name)
PY
}
missing="$(missing_packages 2>/dev/null | tr '\n' ' ' || true)"
if [[ -n "${missing// /}" ]]; then
  echo "nxplay: nxnative now uses Python packages this environment lacks: ${missing% }. A game whose build needs them stops there; add them with: uv pip install --python '${VIRTUAL_ENV:-$venv}' ${missing% }" >&2
fi

# How the build script reports its stages: NX Play reads JSON events (NXPLAY_PROGRESS=json; nxnative's
# docs/frontends.md), a terminal gets the bar redrawn in place, and anything else the script's plain lines.
# tee makes stdout a pipe: a terminal's bar needs the width the script would see there
progress=()
json=0
if [[ "${NXPLAY_PROGRESS:-}" == json ]]; then
  progress=(--progress json)
  json=1
elif [[ -t 1 ]]; then
  progress=(--progress bar)
  export COLUMNS="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
fi

# The IPA, the Mac app and a device install build in the same work folder as the Mac build and rewrite files its
# launcher runs (the patched game code, the shader tables): a kept build would play against them
if [[ $ipa -eq 1 || $mac_app -eq 1 || -n "$device" ]]; then
  for f in "$game"/*_build/keep; do
    if [[ -f "$f" ]]; then
      echo "nxplay: this game's build is kept (NX Play's Keep This Build), and this build would rewrite files it runs; unkeep it first (rm '$f')" >&2
      exit 1
    fi
  done
fi

if [[ $ipa -eq 1 ]]; then
  # the script's own default output (<game folder>/<the profile's IPA name>); it reuses every step a Mac build made
  cd "$repo"
  exec python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" ${lang:+--language "$lang"} ${progress[@]+"${progress[@]}"} ${other_metal[@]+"${other_metal[@]}"} "$@"
fi

if [[ $mac_app -eq 1 ]]; then
  # <game name>.app in the game folder, its files APFS clones of the extracted ones; reuses every step a Mac build made
  cd "$repo"
  out="$(mktemp -t nxplay-macapp)"
  trap 'rm -f "$out"' EXIT
  pack() { python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" --platform mac-app ${lang:+--language "$lang"} ${progress[@]+"${progress[@]}"} ${other_metal[@]+"${other_metal[@]}"} "$@" 2>&1 | tee "$out"; return "${PIPESTATUS[0]}"; }
  # the code it was packed with, for Play (app_is_current), and the save a Finder start plays with
  packed() {
    local app build
    app="$(find_app)"
    [[ -n "$app" ]] || return 0
    build="$game/$(plist "$app" DMTitleID)_build"
    [[ -d "$build" ]] || return 0
    git -C "$repo" rev-parse 'HEAD^{tree}' > "$build/app.tree" 2> /dev/null || true
    share_save "$app" "$build"
  }
  if pack "$@"; then packed; exit 0; fi
  # a game whose shader pairs leave no pipeline base (ANIMAL WELL) stops pso_offline.py with an error instead of
  # "no archive": pack the app without one (--gpu none); it builds what it needs on its first start
  if grep -q 'pso_offline: no base to build' "$out"; then
    echo "nxplay: no pipeline bases to prepare for this game; packing the app without a pipeline archive"
    pack --gpu none "$@" || exit 1
    packed
    exit 0
  fi
  exit 1
fi

# This install's own stages, as build_ipa_from_nsp.py reports its own (JSON events for NX Play, plain lines otherwise),
# so the app's progress bar follows them too
event() { python3 -c 'import json, sys, time; e = json.loads(sys.argv[1]); print(json.dumps({"ev": e.pop("ev"), **e, "t": round(time.time(), 3)}, ensure_ascii=False))' "$1"; }
quote() { python3 -c 'import json, sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$1"; }
stage() {
  stage_t0=$SECONDS
  if (( json )); then event "{\"ev\": \"stage\", \"k\": $1, \"n\": 3, \"name\": $(quote "$2"), \"step\": \"\"}"
  else echo "[$(date +%T)] [$1/3] $2 …"; fi
}
stage_done() {
  local s=$(( SECONDS - stage_t0 ))
  if (( json )); then event "{\"ev\": \"stage_end\", \"k\": $1, \"name\": $(quote "$2"), \"ok\": true, \"summary\": \"\", \"elapsed\": $s}"
  else printf '[%s] ✓ [%s/3] %s (%d:%02d)\n' "$(date +%T)" "$1" "$2" $(( s / 60 )) $(( s % 60 )); fi
}

if [[ -n "$device" ]]; then
  (cd "$repo" && python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" --prepare-xcode ${lang:+--language "$lang"} ${progress[@]+"${progress[@]}"} ${other_metal[@]+"${other_metal[@]}"} "$@")

  project=""
  for p in "$game"/*_build/xcode/DmIOS.xcodeproj; do
    [[ -d "$p" ]] && [[ -z "$project" || "$p" -nt "$project" ]] && project="$p"
  done
  if [[ -z "$project" ]]; then echo "nxplay: --prepare-xcode left no Xcode project in $game" >&2; exit 1; fi
  build="$(dirname "$(dirname "$project")")"
  schemes=("$project"/xcshareddata/xcschemes/*.xcscheme)   # one per game project: "<game name> (<title ID>)"
  scheme="$(basename "${schemes[0]}" .xcscheme)"
  app="$build/xcode-derived-data/Build/Products/Release-iphoneos/DmIOS.app"
  xlog="$build/logs/xcode_device.log"

  # the derived data Xcode uses for this project too; the first build copies the whole game into the app.
  # Built for any iPhone: a device destination needs the phone unlocked through the whole build
  stage 1 "Xcode build · $scheme"
  if ! xcodebuild -project "$project" -scheme "$scheme" -configuration Release -destination 'generic/platform=iOS' \
      -derivedDataPath "$build/xcode-derived-data" -allowProvisioningUpdates -allowProvisioningDeviceRegistration \
      build > "$xlog" 2>&1; then
    grep -E "error:|BUILD FAILED|requires a provisioning|No Account" "$xlog" | tail -20 || true
    echo "nxplay: xcodebuild failed; full log: $xlog" >&2
    exit 1
  fi
  stage_done 1 "Xcode build"

  stage 2 "install"
  xcrun devicectl device install app --device "$device" "$app"
  stage_done 2 "install"

  stage 3 "launch"
  bundle="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Info.plist")"
  if xcrun devicectl device process launch --device "$device" --terminate-existing "$bundle"; then
    stage_done 3 "launch"
  else
    echo "nxplay: installed; unlock the device and open the app (it could not be started from here)"
  fi
  exit 0
fi

# The launcher holds absolute paths (the build printed them): after the game folder or nxnative moved,
# point them at where they are now. The build folder is the launcher's own; it was the parent of `cd <build>/run`.
relocate() {
  python3 - "$1" "$repo" <<'PY'
import os, re, shlex, sys
path, repo = sys.argv[1], os.path.abspath(sys.argv[2])
build = os.path.dirname(os.path.abspath(path))
lines = open(path).read().splitlines()
i = next(i for i, line in enumerate(lines) if line.startswith('cd '))
tokens = shlex.split(lines[i])
old = os.path.dirname(tokens[1])

def fix(value):
    if value == old or value.startswith(old + '/'):
        return build + value[len(old):]
    games = re.search(r'/dm/games/.*$', value)   # a profile table of the nxnative checkout
    if games and not os.path.exists(value) and os.path.exists(repo + games.group(0)):
        return repo + games.group(0)
    return value

# rebuilt the way build_ipa_from_nsp.py writes it: cd <run> && KEY=value ... <host> <patched>
words = []
for token in tokens:
    if token == '&&':
        words.append(token)
    elif re.match(r'[A-Za-z_]\w*=', token):
        key, value = token.split('=', 1)
        words.append(f'{key}={shlex.quote(fix(value))}')
    else:
        words.append(shlex.quote(fix(token)))
cmd = ' '.join(words)
if cmd != lines[i]:
    lines[i] = cmd
    open(path, 'w').write('\n'.join(lines) + '\n')
    print(f'launcher moved: paths now under {build}')
PY
}

start() {
  write_settings "$1"
  if [[ $build_only -eq 1 ]]; then exit 0; fi
  # NX Play shows the game as running from this line on, until then as preparing (Job.gameStarted)
  echo "nxplay: starting the game"
  if [[ $fps -eq 1 ]]; then export DM_METAL_HUD=1; fi
  if [[ $fullscreen -eq 1 ]]; then export DM_FULLSCREEN=1; fi
  if [[ -n "${DM_SAVE_SYNC:-}" && "$DM_SAVE_SYNC" != 0 ]]; then echo "cloud saves: $DM_SAVE_SYNC"; fi
  # the player's choices NX Play passes in the environment (Game Settings), named in NXPLAY_SETTINGS: said in the log
  if [[ -n "${NXPLAY_SETTINGS:-}" ]]; then
    printf 'game settings:'
    for v in $NXPLAY_SETTINGS; do [[ "$v" =~ ^DM_[A-Z0-9_]+$ ]] && printf ' %s=%s' "$v" "${!v:-}"; done
    echo
  fi
  # NX Play orders Console Mode by the last play: marked at the start and, through the EXIT trap, at the end,
  # however the game ends (quit, crash, NX Play's stop). Hence no exec: bash stays to run the trap.
  played="$(dirname "$1")/run/last_played"
  mkdir -p "$(dirname "$played")"
  touch "$played"
  trap 'touch "$played"; [[ -n "${tail_pid:-}" ]] && kill "$tail_pid" 2> /dev/null; true' EXIT
  local app
  app="$(find_app)"
  if [[ -n "$app" ]]; then
    if app_is_current "$app" "$1"; then start_app "$app" "$1"; fi
    echo "nxplay: $(basename "$app") was packed with older nxnative code than this build: playing the build (Make Mac App packs it again)"
  fi
  if [[ -n "$lang" ]]; then
    # the launcher sets DM_LANG inline, which beats the environment: swap the value in its command
    echo "game language: $lang"
    export DM_LANG="$lang"
    bash -c "$(sed -E "s/(^| )DM_LANG=[^ ]*/\1DM_LANG=$lang/" "$1")"
  else
    bash "$1"
  fi
  exit
}

# Plays the game through its Mac app, so the Dock shows the game's own name and icon: its launcher
# (Contents/MacOS/nxnative) started the way nxnative's front-end docs describe (docs/frontends.md, Starting a game),
# without its settings window (DM_LAUNCHER=0: NX Play's settings come in the environment, over the app's saved
# choices), with the game's save and cheats rather than the app's own: the launcher sets DM_SAVE only when the launch
# environment hasn't. The launcher writes the game's output to its log, which is followed here for NX Play's log.
start_app() {
  local app="$1" build id log code=0
  build="$(dirname "$2")"
  id="$(plist "$app" DMTitleID)"
  mkdir -p "$build/run/save"
  share_save "$app" "$build"
  export DM_LAUNCHER=0 DM_SAVE="$build/run/save" DM_CHEATS="$build/cheats"
  if [[ -n "$lang" ]]; then echo "game language: $lang"; export DM_LANG="$lang"; fi
  echo "playing through $(basename "$app")"
  log="$HOME/Library/Logs/nxnative/$id.log"
  tail -q -n 0 -F "$log" 2> /dev/null &
  tail_pid=$!
  "$app/Contents/MacOS/nxnative" || code=$?
  sleep 0.3   # the last lines
  exit "$code"
}

# The launcher records the nxnative code it was built with: when that is not the checkout's, rebuild, whichever run
# pulled the update (an IPA or a device install pulls it too, and rewrites the files the Mac build shares).
# A launcher from before this line was written has none and goes by this run's update alone.
current_tree="$(git -C "$repo" rev-parse 'HEAD^{tree}' 2> /dev/null || true)"
if [[ $rebuild -eq 0 ]]; then
  launcher="$(find_launcher)"
  built=""
  if [[ -n "$launcher" ]]; then built="$(sed -n 's/^# nxnative tree //p' "$launcher")"; fi
  if [[ -n "$built" && -n "$current_tree" && "$built" != "$current_tree" ]]; then
    # a kept build says so below instead
    [[ -f "$(dirname "$launcher")/keep" ]] || echo "nxplay: this build was made with other nxnative code than the checkout has now: rebuilding"
    rebuild=1
  fi
fi

# A build marked kept (NX Play's Keep This Build: a keep file in it) plays as it is after an nxnative update, which
# can break a game that works; only an explicit --rebuild replaces it
if [[ $rebuild -eq 1 && $explicit_rebuild -eq 0 ]]; then
  launcher="$(find_launcher)"
  if [[ -n "$launcher" && -f "$(dirname "$launcher")/keep" ]]; then
    echo "nxplay: this build is kept (NX Play's Keep This Build): playing it without these nxnative changes"
    rebuild=0
  fi
fi

# A game whose original files were removed to free space (NX Play's Remove Game Files) cannot be rebuilt:
# after an nxnative update it keeps playing the build it has, rather than failing to rebuild and not starting
has_game_files() {
  local f
  shopt -s nocasematch
  for f in "$game"/*; do
    case "$f" in *.nsp | *.nsz | *.xci | *.xcz) [[ -s "$f" ]] && return 0 ;; esac
  done
  return 1
}
if [[ $rebuild -eq 1 ]] && ! has_game_files; then
  if [[ $explicit_rebuild -eq 0 && -n "$(find_launcher)" ]]; then
    echo "nxplay: no game files (NSP, NSZ, XCI, XCZ) to rebuild from: playing the current build, without these nxnative changes"
    rebuild=0
  else
    echo "nxplay: no game files (NSP, NSZ, XCI, XCZ) in $game to build from; put them back to rebuild" >&2
    exit 1
  fi
fi

if [[ $rebuild -eq 0 ]]; then
  launcher="$(find_launcher)"
  if [[ -n "$launcher" ]]; then
    echo "already built: $launcher (--rebuild to build again)"
    relocate "$launcher"
    start "$launcher"
  fi
fi

log="$(mktemp -t nxplay)"
trap 'rm -f "$log"' EXIT

(cd "$repo" && python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" --platform mac ${progress[@]+"${progress[@]}"} ${other_metal[@]+"${other_metal[@]}"} "$@") | tee "$log"

# The run command is the message after "done: the game runs on the Mac with this command": a say event's msg in
# JSON, else the next line, without the bar's carriage-return redraws in front of it
cmd="$(python3 - "$log" <<'PY'
import json, sys
found = False
for line in open(sys.argv[1], encoding='utf-8', errors='replace'):
    line = line.rstrip('\n').rsplit('\r', 1)[-1]
    if line.startswith('{"ev": '):
        event = json.loads(line)
        if event.get('ev') != 'say': continue
        line = event.get('msg', '')
    if found:
        print(line)
        break
    found = 'done: the game runs on the Mac with this command' in line
PY
)"
if [[ "$cmd" != cd\ * ]]; then
  echo "nxplay: no run command in the build output" >&2
  exit 1
fi

# "cd <id>_build/run && ...": the launcher goes into <id>_build
run_dir="$(python3 -c 'import shlex, sys; print(shlex.split(sys.argv[1])[1])' "$cmd")"
launcher="$(dirname "$run_dir")/$launcher_name"
printf '#!/bin/sh\n# written by nxplay from the build output\n# nxnative tree %s\n%s\n' "$current_tree" "$cmd" > "$launcher"
chmod +x "$launcher"

echo "saved: $launcher"
rm -f "$log"   # start replaces the EXIT trap
start "$launcher"
